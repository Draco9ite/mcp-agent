SCHEDULED_RUN_TIME=19:00


# ── DocuSign IAM + CLM integration (docusign_iam/) ─────────────────────
# JWT grant (preferred for unattended runs). PRIVATE_KEY accepts a PEM with
# literal \n escapes; PRIVATE_KEY_PATH points at a PEM file instead.
# PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----"
# PRIVATE_KEY_PATH=/secrets/docusign_private.key

# Scopes requested. Leave unset to use the full IAM + CLM set:
#   signature impersonation adm_store_unified_repo_read aow_manage spring_read spring_write
# (authorization code grant uses `extended` in place of `impersonation`)
# DOCUSIGN_OAUTH_SCOPES=

# CLM account and host are discovered from the CLM auth service using the same
# token. Set these only to pin them, or when discovery is unavailable.
# CLM_ACCOUNT_ID=
# CLM_API_BASE_URL=https://apiuatna11.springcm.com
# CLM_CONTENT_BASE_URL=

# CLM workflow names, if an account renamed one on import. Defaults are in
# docusign_iam/agreement_manager.py (CLM_WORKFLOWS).
# CLM_WORKFLOW_PARTY_MANAGEMENT_MIGRATION=
# CLM_WORKFLOW_BULK_METADATA_UPDATE=
# CLM_WORKFLOW_BULK_METADATA_PASS1_CLEAR_NDA_EXPIRATION=
# CLM_WORKFLOW_MFC_AMENDMENT_AI_REVIEW=
# CLM_WORKFLOW_MERGE_DOC_COMBINE_FOLDER_PDFS=
